# The Calcutta Cafe — Environment Configuration Template
# Duplicate this file to .env.local for development or configure directly in Vercel / hosting provider.

# Canonical Production Domain URL
NEXT_PUBLIC_SITE_URL=https://thecalcuttacafe.com

# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Obtain from Google Analytics Admin > Data Streams > Web Stream Details
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML Tag Verification Token
# Obtain from Search Console > Settings > Ownership Verification > HTML tag (content attribute value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Verified Swiggy Outlet URL (Leave blank to use default configured outlet)
NEXT_PUBLIC_SWIGGY_URL=https://www.swiggy.com/restaurants/the-calcutta-cafe-bangalore

# Verified Zomato Outlet URL (Leave blank to use default configured outlet)
NEXT_PUBLIC_ZOMATO_URL=https://www.zomato.com/bangalore/the-calcutta-cafe

